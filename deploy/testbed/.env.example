# Copy to .env (mode 0600). Never commit .env.
# Passwords of the two PostgreSQL roles created on every instance (README, part A).
# Use hex so no character needs escaping in .pgpass: openssl rand -hex 24
BARMAN_PASSWORD=CHANGE_ME
STREAMING_BARMAN_PASSWORD=CHANGE_ME
# Telegram bot token for alerts (name referenced by alerts.telegram.token_env).
TELEGRAM_BOT_TOKEN=CHANGE_ME
