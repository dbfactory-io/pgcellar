# pgCellar test bed on rasp001: nightly base backups until pgCellar runs its own
# schedules (milestone 4). Install: sudo install -m 644 -o root -g root cron.d/pgcellar-testbed /etc/cron.d/
# One server every ten minutes from 03:00, like the schedules in pgcellar.yaml.
# `barman backup` applies the retention policy itself; the forced WAL switch
# closes the segment holding the backup's end LSN (see deploy/testbed/README.md, B8).
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0  3 * * * root docker exec pgcellar sh -c 'barman backup deckhand && barman switch-wal --force --archive --archive-timeout 120 deckhand' >> /var/log/pgcellar-testbed.log 2>&1
10 3 * * * root docker exec pgcellar sh -c 'barman backup chutag   && barman switch-wal --force --archive --archive-timeout 120 chutag'   >> /var/log/pgcellar-testbed.log 2>&1
20 3 * * * root docker exec pgcellar sh -c 'barman backup sygnet   && barman switch-wal --force --archive --archive-timeout 120 sygnet'   >> /var/log/pgcellar-testbed.log 2>&1
30 3 * * * root docker exec pgcellar sh -c 'barman backup listmonk && barman switch-wal --force --archive --archive-timeout 120 listmonk' >> /var/log/pgcellar-testbed.log 2>&1
40 3 * * * root docker exec pgcellar sh -c 'barman backup postiz   && barman switch-wal --force --archive --archive-timeout 120 postiz'   >> /var/log/pgcellar-testbed.log 2>&1
50 3 * * * root docker exec pgcellar sh -c 'barman backup nyx      && barman switch-wal --force --archive --archive-timeout 120 nyx'      >> /var/log/pgcellar-testbed.log 2>&1
