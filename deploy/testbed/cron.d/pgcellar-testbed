# pgCellar test bed on rasp001: nightly base backups until pgCellar runs its own
# schedules (milestone 4). Install: sudo install -m 644 -o root -g root cron.d/pgcellar-testbed /etc/cron.d/
# One server every ten minutes from 03:00, like the schedules in pgcellar.yaml.
# Each backup goes through pgCellar's API (key in /etc/pgcellar-testbed.key, see
# deploy/testbed/README.md, B7) so it shows up on the Runs page and in the audit
# log; StartBackup runs `barman backup` then the forced WAL switch (B9).
# The call answers 202 at once: the backup itself runs inside pgCellar.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
0  3 * * * root curl -fsS -X POST -H "Authorization: Bearer $(cat /etc/pgcellar-testbed.key)" http://127.0.0.1:8082/api/v1/servers/deckhand/backup >> /var/log/pgcellar-testbed.log 2>&1
10 3 * * * root curl -fsS -X POST -H "Authorization: Bearer $(cat /etc/pgcellar-testbed.key)" http://127.0.0.1:8082/api/v1/servers/chutag/backup >> /var/log/pgcellar-testbed.log 2>&1
20 3 * * * root curl -fsS -X POST -H "Authorization: Bearer $(cat /etc/pgcellar-testbed.key)" http://127.0.0.1:8082/api/v1/servers/sygnet/backup >> /var/log/pgcellar-testbed.log 2>&1
30 3 * * * root curl -fsS -X POST -H "Authorization: Bearer $(cat /etc/pgcellar-testbed.key)" http://127.0.0.1:8082/api/v1/servers/listmonk/backup >> /var/log/pgcellar-testbed.log 2>&1
40 3 * * * root curl -fsS -X POST -H "Authorization: Bearer $(cat /etc/pgcellar-testbed.key)" http://127.0.0.1:8082/api/v1/servers/postiz/backup >> /var/log/pgcellar-testbed.log 2>&1
50 3 * * * root curl -fsS -X POST -H "Authorization: Bearer $(cat /etc/pgcellar-testbed.key)" http://127.0.0.1:8082/api/v1/servers/nyx/backup >> /var/log/pgcellar-testbed.log 2>&1
