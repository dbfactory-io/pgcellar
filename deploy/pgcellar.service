[Unit]
Description=pgCellar, control room for PostgreSQL backups (Barman)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=barman
Group=barman
ExecStart=/usr/local/bin/pgcellar serve --config /etc/pgcellar/pgcellar.yaml
# Secrets for alerts (SMTP, Telegram) live here, mode 0600, never in the YAML.
EnvironmentFile=-/etc/pgcellar/pgcellar.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/var/lib/pgcellar /var/lib/barman /etc/pgcellar /etc/barman.d

[Install]
WantedBy=multi-user.target
