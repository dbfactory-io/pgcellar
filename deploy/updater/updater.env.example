# /etc/pgcellar/updater.env: configuration of pgcellar-updater (mode 0600).
# Read by systemd (EnvironmentFile) and by the script itself, so keep it to
# plain KEY=value lines.

# Directory of the docker-compose.yml that runs pgCellar.
COMPOSE_DIR=/srv/pgcellar

# Compose services to restart on the new image. The SSH companion uses the
# same image, so it moves with it.
SERVICE="pgcellar pgcellar-ssh"

# File compose reads its variables from, and the variable that holds the tag
# of the image (image: ghcr.io/dbfactory-io/pgcellar:${PGCELLAR_TAG:-latest}).
#ENV_FILE=/srv/pgcellar/.env
#TAG_VAR=PGCELLAR_TAG

# Where pgCellar answers, from the host.
API_URL=http://127.0.0.1:8080

# File holding an API key with the operator role (one line, mode 0600):
#   pgcellar apikey create --config /etc/pgcellar/pgcellar.yaml --name updater --role operator
API_KEY_FILE=/etc/pgcellar/updater.key

# Seconds to wait for /healthz and the new version before rolling back.
HEALTH_TIMEOUT=180

# 1 = say what would be done, change nothing.
DRY_RUN=0

# docker, or podman (podman compose must work).
DOCKER=docker
