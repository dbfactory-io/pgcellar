#!/usr/bin/env bash
# fake-barman: a stand-in for the Barman command line, used by the public demo
# (pgcellar serve --demo). It answers read-only commands from the JSON files in
# ./fixtures, which pgCellar's demo writes (and rewrites as time goes by) from
# its fictional data set. A server is known when fixtures/check-<server>.json
# exists. Nothing that would change a backup is simulated: backup, delete,
# recover and switch-wal answer that this is the demo.

set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fx="$here/fixtures"

format=console
while [ $# -gt 0 ]; do
  case "$1" in
    -f|--format) format="${2:-}"; shift 2 ;;
    --format=*) format="${1#--format=}"; shift ;;
    -c|--config|--log-level) shift 2 ;;
    -q|--quiet|-d|--debug) shift ;;
    -h|--help) echo "usage: barman [-h] [-c CONFIG] [-q] [-d] [-f {json,console}] {check,diagnose,list-servers,list-backups,show-backup,status,cron} ..."; exit 0 ;;
    -*) echo "barman: error: unrecognized arguments: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done

if [ $# -eq 0 ]; then
  echo "usage: barman [-h] ... command" >&2
  exit 2
fi
cmd="$1"; shift

known_server() { [ -f "$fx/check-$1.json" ]; }

# fail MESSAGE: Barman style error (JSON when asked), exit status 1.
fail() {
  if [ "$format" = json ]; then
    printf '{"_ERROR": ["%s"]}' "$1"
  else
    echo "ERROR: $1" >&2
  fi
  exit 1
}

need_server() {
  [ $# -ge 1 ] && [ -n "$1" ] || { echo "barman: error: the following arguments are required: server_name" >&2; exit 2; }
  known_server "$1" || fail "Unknown server '$1'"
}

emit() {
  if [ "$format" = json ]; then
    cat "$fx/$1"
  else
    echo "(console output of '$cmd' is not simulated, use --format json)"
  fi
}

minimal=0
args=()
while [ $# -gt 0 ]; do
  a="$1"; shift
  case "$a" in
    --minimal) minimal=1 ;;
    --target-time) shift ;;
    --target-immediate|--force|--archive|--wait|--no-wait) ;;
    -*) echo "barman: error: unrecognized arguments: $a" >&2; exit 2 ;;
    *) args+=("$a") ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

case "$cmd" in
  list-servers)
    emit list-servers.json
    ;;
  diagnose)
    if [ "$format" = json ]; then printf '{"_INFO": []}'; else echo "(diagnose is not simulated)"; fi
    ;;
  check)
    need_server "${1:-}"
    emit "check-$1.json"
    if grep -q '"FAILED"' "$fx/check-$1.json"; then exit 1; fi
    exit 0
    ;;
  status)
    need_server "${1:-}"
    emit "status-$1.json"
    ;;
  list-backups)
    need_server "${1:-}"
    emit "list-backups-$1.json"
    ;;
  show-backup)
    need_server "${1:-}"
    id="${2:-}"
    [ -n "$id" ] || { echo "barman: error: the following arguments are required: backup_id" >&2; exit 2; }
    case "$id" in
      latest|last) id=$(ls "$fx" | sed -n "s/^show-backup-$1-\(.*\)\.json$/\1/p" | sort | tail -n 1) ;;
      first|oldest) id=$(ls "$fx" | sed -n "s/^show-backup-$1-\(.*\)\.json$/\1/p" | sort | head -n 1) ;;
    esac
    [ -f "$fx/show-backup-$1-$id.json" ] || fail "Unknown backup '$2' for server '$1'"
    emit "show-backup-$1-$id.json"
    ;;
  cron)
    [ "$format" = json ] && printf '{"_INFO": []}'
    exit 0
    ;;
  backup|switch-wal|delete|recover)
    fail "This is the public demo: nothing is changed"
    ;;
  *)
    echo "barman: error: argument command: invalid choice: '$cmd'" >&2
    exit 2
    ;;
esac
